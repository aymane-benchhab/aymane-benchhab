flowchart LR
  ING["Ingénieur<br/>fiche de besoin<br/>puissance, fluide, heures"]:::ext

  subgraph VPC["VPC partagé  -  UseCase = uc02-hydraulic-schema"]
    direction LR
    IN[("S3 /uc02/input")]:::storage

    subgraph SFN["Step Functions  sfn-uc02-pipeline"]
      direction TB
      V["1 · Valider la fiche<br/>Lambda validate"]:::compute
      R["2 · Récupérer règles<br/>Lambda retrieve"]:::compute
      G["3 · Générer JSON<br/>Lambda generate<br/>Map : 1 branche / modèle"]:::compute
      C["4 · Contrôler règles<br/>Lambda rules-check"]:::compute
      D{"Conforme ?"}:::decision
      X["5 · JSON → DXF<br/>Lambda conteneur ezdxf"]:::compute
      M["6 · Comparer modèles<br/>Lambda score"]:::compute
      V --> R --> G --> C --> D
      D -- "non · max 3" --> G
      D -- "oui" --> X --> M
    end

    OUT[("S3 /uc02/output<br/>schema.json · .dxf · rapport")]:::storage
    COR[("S3 /uc02/corpus<br/>règles · projets")]:::storage
    ECR["ECR<br/>image ezdxf"]:::compute
  end

  subgraph BR["Amazon Bedrock"]
    direction TB
    M1["Claude Sonnet"]:::ai
    M2["Claude Haiku"]:::ai
    M3["Amazon Nova<br/>ou autre modèle"]:::ai
    KB["Knowledge Base<br/>vecteurs S3 Vectors"]:::ai
  end

  NA[("Neptune Analytics<br/>équipements = noeuds<br/>connexions = arêtes")]:::db

  ING --> IN --> V
  G --> M1 & M2 & M3
  R --> KB
  COR -- "ingestion" --> KB
  KB -. "phase 3 · GraphRAG" .-> NA
  X --> OUT
  M --> OUT
  ECR -.-> X

  classDef compute fill:#ED7100,stroke:#B35500,color:#fff
  classDef ai fill:#01A88D,stroke:#017A66,color:#fff
  classDef db fill:#C925D1,stroke:#8F1A95,color:#fff
  classDef storage fill:#7AA116,stroke:#577311,color:#fff
  classDef ext fill:#ffffff,stroke:#5A6B7B,color:#232F3E
  classDef decision fill:#FFF4E5,stroke:#ED7100,color:#232F3E
