flowchart LR
  subgraph SRC["Sources publiques"]
    direction TB
    HF["HuggingFace<br/>benchmarks"]:::ext
    AO["Appels d'offres<br/>TED, BOAMP"]:::ext
  end

  subgraph TRIG["Déclencheurs"]
    direction TB
