      AN["Analyste<br/>scoring Go/No-Go"]:::compute
      RD["Rédacteur<br/>synthèse"]:::compute
    end

    MCP["Lambda MCP<br/>outils : web, S3"]:::compute
    EV["Lambda Évaluateur<br/>LLM-as-judge"]:::compute
    DDB[("DynamoDB<br/>checkpoints LangGraph")]:::db
  end

  subgraph BR["Amazon Bedrock"]
    direction TB
    HK["Claude Haiku<br/>inference profile uc01"]:::ai
    GR["Guardrails"]:::sec
  end

  S3[("S3 /uc01<br/>raw · results · evals")]:::storage
